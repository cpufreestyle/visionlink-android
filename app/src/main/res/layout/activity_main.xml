<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ROI Focus Frame -->
    <View
        android:id="@+id/roiFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/roi_frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode: Obstacle"
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Ready"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- AI Status -->
        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Tap Init AI"
            android:textColor="#FF9800"
            android:textSize="13sp" />

        <!-- FPS Display -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="FPS: 0"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Result Display -->
    <ScrollView
        android:id="@+id/resultScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="#80000000"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Results shown here"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </ScrollView>

    <!-- Bottom Control Bar (Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Mode 1: Obstacle -->
            <Button
                android:id="@+id/btnMode1"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#FF0000"
                android:text="Mode 1\nObstacle"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Mode 2: Text -->
            <Button
                android:id="@+id/btnMode2"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#FFAA00"
                android:text="Mode 2\nText"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Mode 3: Scene -->
            <Button
                android:id="@+id/btnMode3"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#0000FF"
                android:text="Mode 3\nScene"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Download Model -->
            <Button
                android:id="@+id/btnDownloadModel"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#9C27B0"
                android:text="Download\nModel"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Init AI -->
            <Button
                android:id="@+id/btnInitAI"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#FF9800"
                android:text="Init AI"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Continuous Mode -->
            <Button
                android:id="@+id/btnContinuous"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#00AA00"
                android:text="Start\nContinuous"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Capture (Single Shot) -->
            <Button
                android:id="@+id/btnCapture"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#2196F3"
                android:text="Capture\nSingle"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Settings -->
            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#607D8B"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Exit -->
            <Button
                android:id="@+id/btnExit"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:backgroundTint="#666666"
                android:text="Exit"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Glasses Status -->
    <TextView
        android:id="@+id/tvGlassesStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:padding="4dp"
        android:text="Glasses: N/A"
        android:textColor="#FF0000"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
