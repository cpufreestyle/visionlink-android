<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ui.MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="摄像头预览画面"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ROI Focus Frame -->
    <View
        android:id="@+id/roiFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/roi_frame"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_obstacle"
            android:textColor="#00FF00"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/status_ready"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- AI Status -->
        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/tap_init_ai"
            android:textColor="#FF9800"
            android:textSize="13sp" />

        <!-- FPS Display -->
        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="FPS: 0"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Result Display -->
    <ScrollView
        android:id="@+id/resultScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@+id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </ScrollView>

    <!-- Glasses Status -->
    <TextView
        android:id="@+id/tvGlassesStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@android:color/transparent"
        android:padding="4dp"
        android:text="@string/glasses_na"
        android:textColor="#FF0000"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar" />

    <!-- Bottom Control Bar — 两行网格，无需滚动 -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 第一行：4个模式按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button android:id="@+id/btnMode1" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#FF0000"
                android:text="@string/mode_obstacle" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="障碍物避障模式" />

            <Button android:id="@+id/btnMode2" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#FFAA00"
                android:text="@string/mode_text" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="读文字模式" />

            <Button android:id="@+id/btnMode3" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#0000FF"
                android:text="@string/mode_scene" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="场景描述模式" />

            <Button android:id="@+id/btnMode4" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#00BCD4"
                android:text="@string/mode_guide" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="指向引导模式" />

        </LinearLayout>

        <!-- 第二行：拍照、连续、引擎、更多 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button android:id="@+id/btnCapture" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#2196F3"
                android:text="@string/capture_single" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="拍照分析" />

            <Button android:id="@+id/btnContinuous" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#00AA00"
                android:text="@string/start_continuous" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="开始或停止连续检测" />

            <Button android:id="@+id/btnSwitchEngine" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#004D40"
                android:text="引擎: YOLO" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="切换AI引擎" />

            <Button android:id="@+id/btnMore" style="@style/Widget.Material3.Button"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:layout_margin="2dp"
                android:backgroundTint="#607D8B"
                android:text="更多" android:textColor="#FFFFFF" android:textSize="13sp"
                android:contentDescription="更多功能" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
